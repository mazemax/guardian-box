# GuardianBox Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Telegram Bot Configuration (optional but recommended)
# =============================================================================
# Create a bot via @BotFather on Telegram, then get your chat ID by sending /start
# See docs/telegram-setup.md for detailed instructions
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_IDS=987654321,123456789
#
# If not set, the dashboard shows a mock Telegram preview panel instead

# =============================================================================
# Mode Configuration
# =============================================================================
# Set to 'true' to run in mock/simulation mode (no GPU, camera, or mic required)
MOCK_MODE=false

# Demo profile: 'home' (default) or 'demo' (shorter timings for stage demos)
DEMO_PROFILE=home

# =============================================================================
# Camera Configuration
# =============================================================================
# USB camera device or RTSP URL
CAMERA_SOURCE=/dev/video0
# CAMERA_SOURCE=rtsp://user:pass@192.168.1.100:554/stream

# Resolution and FPS
FRAME_WIDTH=1280
FRAME_HEIGHT=720
TARGET_FPS=15

# =============================================================================
# Network Configuration
# =============================================================================
# Dashboard port (exposed on localhost)
DASHBOARD_PORT=8080

# Internal service URLs (only change if running services externally)
VLLM_URL=http://vllm:8000
STT_URL=http://stt:8001
VOICE_URL=http://voice:8002
NOTIFIER_URL=http://notifier:8003
VISION_URL=http://vision:8004

# =============================================================================
# Sample Clips Directory
# =============================================================================
# Path to sample video clips for replay testing
SAMPLES_DIR=/app/samples

# =============================================================================
# Model Cache
# =============================================================================
# Path to Hugging Face cache with pre-downloaded models
HF_CACHE=~/.cache/huggingface

# =============================================================================
# Timezone
# =============================================================================
TZ=Asia/Kuala_Lumpur

# =============================================================================
# Testing / Presenter Mode
# =============================================================================
# Simulate internet offline (for demo)
SIMULATE_OFFLINE=false
