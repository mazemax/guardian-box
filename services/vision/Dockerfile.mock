# GuardianBox Vision Service - Mock/CPU-only build
# Lightweight image for demo/development without GPU dependencies
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install lightweight Python dependencies (no torch/CUDA)
COPY requirements-mock.txt .
RUN pip install --no-cache-dir -r requirements-mock.txt

COPY vision_service.py .

# Create samples directory mount point
RUN mkdir -p /samples

EXPOSE 8004

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

CMD ["uvicorn", "vision_service:app", "--host", "0.0.0.0", "--port", "8004"]
